# Interview Copilot — environment (all optional for MVP).
# Providers use your existing local CLI logins (kiro-cli / claude / cursor-agent); no API keys needed.

# Local server port (default 8791).
PORT=8791

# --- Standalone WebRTC call (Phase 8, optional) ---
# The call works peer-to-peer over public STUN by default. For symmetric NATs /
# strict firewalls, point it at a TURN relay (e.g. a self-hosted coturn).
# TURN_URLS is comma-separated; TURN_USERNAME/TURN_PASSWORD are the relay creds.
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_USERNAME=your-turn-user
# TURN_PASSWORD=your-turn-secret
# Optional: override the default public STUN list (comma-separated).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
